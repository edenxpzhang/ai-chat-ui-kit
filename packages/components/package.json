{
  "name": "@ai-chat-ui-kit/components",
  "version": "0.2.4",
  "description": "Web Components for AI Chat UI Kit (Lit)",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/index.css",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/edenxpzhang/ai-chat-ui-kit.git",
    "directory": "packages/components"
  },
  "homepage": "https://edenxpzhang.github.io/ai-chat-ui-kit/",
  "bugs": {
    "url": "https://github.com/edenxpzhang/ai-chat-ui-kit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./style": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./react": {
      "types": "./dist/react.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && node -e \"require('fs').copyFileSync('src/react.d.ts', 'dist/react.d.ts')\""
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-chat/core": {
      "optional": true
    }
  }
}
