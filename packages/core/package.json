{
  "name": "@ai-chat-ui-kit/core",
  "version": "0.1.2",
  "description": "Core logic layer for AI Chat UI Kit (Headless)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/edenxpzhang/ai-chat-ui-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://edenxpzhang.github.io/ai-chat-ui-kit/",
  "bugs": {
    "url": "https://github.com/edenxpzhang/ai-chat-ui-kit/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "chat",
    "headless",
    "store"
  ],
  "author": "edenxpzhang",
  "license": "MIT",
  "dependencies": {
    "marked": "^12.0.0",
    "marked-highlight": "^2.0.0",
    "highlight.js": "^11.9.0",
    "mermaid": "^10.9.0",
    "katex": "^0.16.0"
  },
  "devDependencies": {
    "tsup": "^7.0.0",
    "typescript": "^5.0.0"
  }
}
